#!/bin/bash
#
# df-limit-mocy - hard CPU power limit on AMD Ryzen mobile, via ryzenadj.
#
#   df-limit-mocy             prints "stapm fast slow fstapm ffast fslow" in W:
#                             the current limits, then the factory ones
#   df-limit-mocy 7           sets STAPM, PPT fast and PPT slow to 7 W
#   df-limit-mocy fabryczny   restores the factory limits
#
# Called by Cogwheel (services/LimitMocy.qml) through sudo, on every power
# profile change and once a minute.
#
# THREE LIMITS, ONE NUMBER. The SMU has a sustained limit (STAPM), a short
# burst limit (PPT fast) and an average one (PPT slow). Setting all three to
# the same value makes it a hard ceiling - no boost above it, not even for a
# few seconds. The limit covers the CPU with its integrated GPU, not the whole
# laptop: the screen, Wi-Fi and disk come on top.
#
# FACTORY LIMITS ARE PER PLATFORM PROFILE. On a ThinkPad the firmware sets
# its own limits on every platform_profile change (low-power, balanced,
# performance) - on this laptop low-power alone is 10 W. So the factory values
# are kept separately for each profile, in /run (tmpfs, cleared at shutdown),
# and recorded on the first call in that profile - but only when the current
# limits are not the ones this script wrote last. Otherwise the firmware did
# not touch them (a laptop without per-profile limits, or no profile change
# yet), and they say nothing about the factory. Until a profile has its own
# record, the first one recorded stands in for it.
#
# STAPM IS READ LATE. On a profile change the ThinkPad firmware sets all
# three limits, but the SMU reports the new STAPM only 1.5-2 s later, while
# the first call in a new profile comes after 0.8 s - so a recorded STAPM is
# the previous profile's. Measured on this ThinkPad with nothing else writing,
# the firmware's STAPM equals its PPT fast in every profile (low-power
# 10/10/10, balanced 25/25/20, performance 40/40/35), so the factory STAPM
# is taken as the recorded PPT fast.
#
# One exception: the firmware may set the new profile to exactly the value
# written last. So the last write remembers its profile too, and once a
# profile change has been SEEN to reset the limits, a profile change alone is
# enough to record the new profile's factory values.
#
# IDEMPOTENT. A write happens only when the current limits differ from the
# requested ones. Some firmware quietly restores its own limits (charger
# plugged in, resume), which is why the shell repeats the call every minute;
# most of those calls only read.
#
# ROOT, NOT A USER SCRIPT. ryzenadj talks to the SMU through /dev/mem, so it
# needs root and the iomem=relaxed kernel parameter (with STRICT_DEVMEM). The
# script lives in /usr/local/sbin owned by root, and sudoers
# (sudoers/dark-fantasy-moc) lets the wheel group run it without a password.
# That is why it does not sit in ~/.local/bin next to limit-ladowania: a
# passwordless sudo rule for a file the user can edit would be root for
# anything. The arguments are validated below for the same reason.
#
# EXIT CODES (translated in Cogwheel): 2 no ryzenadj, 3 not root,
# 4 no SMU access (iomem=relaxed missing), 5 bad argument.

set -euo pipefail
PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RYZENADJ=/usr/local/bin/ryzenadj
STAN=/run/df-limit-mocy
OSTATNI=$STAN/ustawiony

PROFIL="$(cat /sys/firmware/acpi/platform_profile 2>/dev/null || true)"
[[ $PROFIL =~ ^[a-z-]+$ ]] || PROFIL=brak
FABRYCZNE=$STAN/fabryczne-$PROFIL

MIN_W=4
MAX_W=54

(( EUID == 0 )) || { echo "df-limit-mocy: run as root (sudo)" >&2; exit 3; }
[[ -x $RYZENADJ ]] || { echo "df-limit-mocy: $RYZENADJ not found" >&2; exit 2; }

# Arguments first, before anything is read or recorded. At most two digits,
# no leading zero: bash reads "0060" as octal 48, which would pass the range
# check while awk below makes it 60 W.
if (( $# > 1 )) || { (( $# == 1 )) && [[ $1 != fabryczny ]] &&
        { ! [[ $1 =~ ^[1-9][0-9]?$ ]] || (( 10#$1 < MIN_W || 10#$1 > MAX_W )); }; }; then
    echo "df-limit-mocy: one argument: a whole number of watts, $MIN_W-$MAX_W, or \"fabryczny\"" >&2
    exit 5
fi

# "stapm fast slow" in W from the ryzenadj --info table, e.g. "28.000 35.000 30.000".
odczyt() {
    "$RYZENADJ" --info 2>/dev/null | awk -F'|' '
        { gsub(/^ +| +$/, "", $2); gsub(/ /, "", $3) }
        $2 == "STAPM LIMIT"    { a = $3 }
        $2 == "PPT LIMIT FAST" { b = $3 }
        $2 == "PPT LIMIT SLOW" { c = $3 }
        END { if (a != "" && b != "" && c != "") print a, b, c }'
}

obecne="$(odczyt || true)"
if [[ -z $obecne ]]; then
    echo "df-limit-mocy: no SMU access - is iomem=relaxed on the kernel command line?" >&2
    exit 4
fi

# Watts as mW integers; the SMU reports with three decimals.
mw() { awk -v w="$1" 'BEGIN { printf "%d", w * 1000 + 0.5 }'; }
mw3() { echo "$(mw "$1") $(mw "$2") $(mw "$3")"; }

mkdir -p "$STAN"
read -r oa ob oc <<< "$obecne"
if [[ ! -s $FABRYCZNE ]]; then
    # "profile stapm fast slow" of the last write, the values in mW.
    lp="" lw=""
    [[ -s $OSTATNI ]] && read -r lp lw <<< "$(<"$OSTATNI")"
    zapisz=0
    if [[ -z $lp ]]; then
        zapisz=1
    elif [[ $lw != "$(mw3 "$oa" "$ob" "$oc")" ]]; then
        zapisz=1
        [[ $lp != "$PROFIL" ]] && touch "$STAN/firmware-resetuje"
    elif [[ $lp != "$PROFIL" && -e $STAN/firmware-resetuje ]]; then
        zapisz=1
    fi
    if (( zapisz )); then
        echo "$obecne" > "$FABRYCZNE"
        [[ -s $STAN/pierwszy ]] || echo "$obecne" > "$STAN/pierwszy"
    fi
fi
if [[ -s $FABRYCZNE ]]; then
    fabryczne="$(<"$FABRYCZNE")"
elif [[ -s $STAN/pierwszy ]]; then
    fabryczne="$(<"$STAN/pierwszy")"
else
    fabryczne="$obecne"
fi
# Factory STAPM = factory PPT fast - see "STAPM IS READ LATE" above.
read -r fa fb fc <<< "$fabryczne"
fabryczne="$fb $fb $fc"

if [[ $# -eq 0 ]]; then
    echo "$obecne $fabryczne"
    exit 0
fi

case "$1" in
fabryczny)
    read -r a b c <<< "$fabryczne"
    ;;
*)
    a=$1 b=$1 c=$1
    ;;
esac

if [[ "$(mw3 "$oa" "$ob" "$oc")" != "$(mw3 "$a" "$b" "$c")" ]]; then
    "$RYZENADJ" --stapm-limit="$(mw "$a")" --fast-limit="$(mw "$b")" \
                --slow-limit="$(mw "$c")" >/dev/null
    echo "$PROFIL $(mw3 "$a" "$b" "$c")" > "$OSTATNI"
    # What was written, not a fresh read: the SMU reports a new STAPM only
    # 1.5-2 s later, and Cogwheel would show the old one for a minute.
    obecne="$(awk -v a="$a" -v b="$b" -v c="$c" 'BEGIN { printf "%.3f %.3f %.3f", a, b, c }')"
fi

echo "$obecne $fabryczne"
