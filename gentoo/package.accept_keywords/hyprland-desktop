# Hyprland dark-fantasy desktop

# The Hyprland stack from hyproverlay. Every package here has only
# KEYWORDS="~amd64", Hyprland 0.56 included, so without these lines Portage
# masks them as "missing keyword" and bootstrap.sh stops at gui-wm/hyprland.
# Unversioned on purpose: the overlay moves them together, and a pinned
# version would mask the next one.
gui-wm/hyprland ~amd64
gui-libs/aquamarine ~amd64
gui-libs/hyprutils ~amd64
dev-libs/hyprlang ~amd64
dev-libs/hyprgraphics ~amd64
gui-libs/hyprcursor ~amd64
gui-libs/hyprwire ~amd64
dev-libs/hyprland-protocols ~amd64
dev-util/hyprwayland-scanner ~amd64
dev-cpp/glaze ~amd64
gui-libs/hyprtoolkit ~amd64
gui-libs/hyprland-guiutils ~amd64
gui-apps/hyprpaper ~amd64

# Pulled in by Quickshell's default USE (crash handler). Main Gentoo tree,
# ~amd64 only.
dev-cpp/cpptrace ~amd64
gui-apps/hyprlock ~amd64
gui-apps/hypridle ~amd64
sys-auth/hyprpolkitagent ~amd64
gui-libs/hyprland-qt-support ~amd64
gui-libs/xdg-desktop-portal-hyprland ~amd64
gui-apps/wl-clipboard ~amd64
app-misc/cliphist ~amd64
gui-apps/hyprshot ~amd64
gui-apps/swaync ~amd64
gui-apps/rofi-wayland ~amd64
media-fonts/nerdfonts ~amd64
dev-cpp/sdbus-c++ ~amd64
gui-libs/gtk4-layer-shell ~amd64

# libwayland 1.26. Hyprland 0.56 does not work with the stable
# dev-libs/wayland 1.25.0, although its ebuild only asks for >=1.22.91.
# In the Gentoo tree 1.26.0 is still ~amd64, while dev-util/wayland-scanner
# 1.26.0 and dev-libs/wayland-protocols 1.49 are already stable. bootstrap.sh
# upgrades it (--oneshot) before installing Hyprland; by hand:
#   sudo emerge --ask --oneshot --update ">=dev-libs/wayland-1.26.0"
>=dev-libs/wayland-1.26.0 ~amd64

# Quickshell - the desktop's widget and panel layer, written in QtQuick/QML.
# The package lives in the "guru" overlay, which is already enabled in repos.conf.
# Version 0.3.1 has KEYWORDS="~amd64 ~arm64", so without this line Portage
# masks it as "missing keyword" and emerge refuses to install it.
gui-apps/quickshell ~amd64

# Yazi - the desktop's file manager (SUPER+W shortcut). It lives in the
# "guru" overlay and has KEYWORDS="~amd64 ~arm64", so without this line Portage
# masks it as "missing keyword".
app-misc/yazi ~amd64

# tty-clock - a full-screen clock in the terminal. Unlike the
# other entries it is in the MAIN Gentoo repository, not in an overlay,
# but it still has KEYWORDS="~amd64 ~arm64 ~ppc64".
app-misc/tty-clock ~amd64

# Dark Souls-style look. All three packages have only
# tilde KEYWORDS (~amd64), so without these lines Portage masks them as
# "missing keyword". eb-garamond and btop are stable and need no entry.
#   adw-gtk3, bibata-xcursors - "guru" overlay
#   papirus-icon-theme        - main Gentoo repository
x11-themes/adw-gtk3 ~amd64
x11-themes/bibata-xcursors ~amd64
x11-themes/papirus-icon-theme ~amd64
